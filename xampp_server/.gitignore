# --- Rendszer és Ideiglenes fájlok ---
# Ezek folyamatosan változnak és nem kellenek a repóba
/tmp/
*.tmp
*.log
*.err
*.pid
Thumbs.db
.DS_Store

# --- Nem használt XAMPP Szolgáltatások ---
# Mivel csak Apache-ot és MySQL-t használsz, ezeket a mappákat kihagyjuk
# a helytakarékosság érdekében. (Ezek teljes mappák a gyökérben)
/anonymous/
/FileZillaFTP/
/MercuryMail/
/tomcat/
/webalizer/
/webdav/
# A Perl-t gyakran használják belső scriptek, de ha csak PHP-t futtatsz,
# általában kihagyható. Ha hiba lépne fel a Control Panelben, ezt vedd ki:
/perl/

# --- Apache ---
# A konfigurációt (conf) és a binárisokat (bin) MEGTARTJUK.
# Csak a logokat és teszteket dobjuk el.
/apache/logs/
/apache/test/

# --- PHP ---
# A php.ini és a kiegészítők maradnak.
/php/logs/
/php/temp/
# A PEAR cache gyakran szemetel
/php/pear/cache/

# --- MySQL ---
# A binárisok maradnak, hogy elinduljon a szerver.
/mysql/backup/
/mysql/scripts/
/mysql/test/
# A MySQL logokat és PID fájlokat ne mentsük, mert ezek futásidőben jönnek létre
/mysql/data/*.err
/mysql/data/*.log
/mysql/data/*.pid
/mysql/data/*.bak

# MEGJEGYZÉS ADATBÁZISHOZ:
# A /mysql/data/ mappát NEM ignorálom teljesen, mert abban vannak a
# rendszer táblák (mysql, performance_schema), amik nélkül nem indul el a szerver.
# Viszont a saját adatbázisod (dbchatex) bináris fájljai is itt lesznek.
# Git-ben bináris adatbázist tárolni nem optimális, de hordozhatóság miatt most engedjük.

# --- HTDOCS (Weboldalak) ---
# Itt van a lényeg. Kihagyjuk a XAMPP alapértelmezett szemetét,
# de a ChatexProject-et mindenképp megtartjuk.

/htdocs/dashboard/
/htdocs/img/
/htdocs/webalizer/
/htdocs/xampp/

# --- Telepítők és Uninstallerek ---
install.exe
uninstall.exe
/install/